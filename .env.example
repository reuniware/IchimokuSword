# ===========================================================================
# IchimokuSword - Configuration MetaTrader 5
# ===========================================================================
# Copiez ce fichier en .env et ajustez les paramètres
# ===========================================================================

# Chemin vers terminal64.exe (optionnel si MT5 est dans le dossier par défaut)
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Identifiants du compte (facultatif si déjà connecté dans le terminal)
# MT5_LOGIN=12345678
# MT5_PASSWORD=votre_mot_de_passe
# MT5_SERVER=YourBroker

# Watchlist personnalisée (optionnelle, prioritaire sur la défaut)
# ICHIMOKU_WATCHLIST=EURUSD,GBPUSD,XAUUSD,US30,BTCUSD
